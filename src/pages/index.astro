---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="hero-accueil" aria-labelledby="titre-accueil">
      <div class="hero-contenu">
        <p class="hero-surtitre">Comprendre pour mieux choisir</p>
        <h1 id="titre-accueil">
          L’intelligence artificielle a aussi un coût écologique.
        </h1>
        <p class="hero-description">
          Découvrez ce que l’on sait de son impact environnemental, explorez les
          données et faites des choix plus éclairés.
        </p>
        <div class="hero-actions">
          <a class="hero-bouton" href="/stats/quiz">
            Tester mes connaissances <span aria-hidden="true">→</span>
          </a>
          <a class="hero-lien" href="/aboutIA">Découvrir le sujet</a>
        </div>
      </div>

      <div class="hero-visuel" aria-hidden="true">
        <div class="hero-orbite hero-orbite-externe"></div>
        <div class="hero-orbite hero-orbite-interne"></div>
      
        <div class="hero-message">
       
        </div>
      </div>
    </section>
  </main>
</Layout>
